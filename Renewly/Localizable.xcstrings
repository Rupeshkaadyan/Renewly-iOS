    "Renewly has no servers, no ads and no tracking. Your data lives on your devices and in your private iCloud — we can't see any of it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renewly has no servers, no ads and no tracking. Your data lives on your devices and in your private iCloud — we can't see any of it."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renewly का कोई सर्वर, कोई विज्ञापन और कोई ट्रैकिंग नहीं है। आपका डेटा आपके डिवाइसों और आपके निजी iCloud में रहता है — हम इसे देख भी नहीं सकते।"
          }
        }
      }
    },
    "Renewly reminds you a day before every renewal and trial end — at 9:00 AM, never more." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renewly reminds you a day before every renewal and trial end — at 9:00 AM, never more."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
